# Weather MCP Server Environment Variables
# Copy this file to .env for local testing

# Databricks Secret Configuration
# These are used to fetch the OpenWeatherMap API key from Databricks secrets
WEATHER_SECRET_SCOPE=weather
WEATHER_API_KEY_SECRET_KEY=openweather-api-key

# Local Development (optional)
# For local testing without Databricks secrets, you can set this directly
# NEVER commit the actual API key to version control!
# OPENWEATHER_API_KEY=your_api_key_here
